# XGAME: copy thành .env rồi điền giá trị thật. KHÔNG commit file .env.
# Sinh chuỗi ngẫu nhiên: openssl rand -hex 32

# Domain trỏ về VPS (bản ghi A/AAAA) và email nhận thông báo chứng chỉ Let's Encrypt
DOMAIN=ai.example.com
ACME_EMAIL=

# PostgreSQL — mật khẩu chỉ dùng chữ và số (hex) để không phải escape trong URL kết nối
POSTGRES_USER=newapi
POSTGRES_PASSWORD=
POSTGRES_DB=new-api

# Redis
REDIS_PASSWORD=

# Bí mật phiên đăng nhập và mã hoá dữ liệu. Không đổi sau khi đã chạy thật
# (đổi CRYPTO_SECRET sẽ làm hỏng dữ liệu đã mã hoá).
SESSION_SECRET=
CRYPTO_SECRET=

# Ngôn ngữ log và thông báo backend: en, zh-CN, zh-TW
DEFAULT_LANGUAGE=en

# Google Chat incoming webhook nhận cảnh báo key nhà cung cấp bị disable
# (hết số dư, key bị thu hồi...). Để trống thì không gửi. URL chứa key/token — giữ bí mật.
XGAME_GCHAT_WEBHOOK_URL=

# Backup PostgreSQL (backup.sh)
BACKUP_DIR=./backups
BACKUP_KEEP_DAYS=7
